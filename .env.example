# =========================================================================
# FASALCLAIM ENVIRONMENT CONFIGURATION
# Production-ready Next.js & Supabase Configuration
# Note: FasalClaim works seamlessly out-of-the-box in interactive Demo Mode 
# even without external API credentials.
# =========================================================================

# App URL
NEXT_PUBLIC_APP_URL=https://fasalclaim.vercel.app

# Supabase PostgreSQL & Auth Credentials (Optional for cloud database & real auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# Storage Bucket (Private bucket for claim documents)
SUPABASE_STORAGE_BUCKET=claim-documents-private

# Optional Server-Side LLM Integration for Plain-Language Explanation
# Note: Deterministic rule-based checks remain authoritative. LLM only generates plain explanations.
OPENAI_API_KEY=
GEMINI_API_KEY=

